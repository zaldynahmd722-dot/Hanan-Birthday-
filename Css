* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  color: white;
  background: linear-gradient(135deg, #160021, #4b145f, #17001f);
  overflow-x: hidden;
}

.container {
  width: 92%;
  max-width: 650px;
  margin: auto;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.screen {
  display: none !important;
  width: 100%;
  padding: 35px 25px;
  text-align: center;
  border-radius: 25px;
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  box-shadow: 0 15px 50px rgba(0,0,0,0.4);
}

.screen.active {
  display: block !important;
}

h1 {
  font-size: 45px;
}

h2 {
  font-size: 30px;
}

p {
  font-size: 18px;
  line-height: 2;
}

button {
  border: none;
  padding: 14px 25px;
  border-radius: 30px;
  background: #ff4f9a;
  color: white;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 15px;
}

.gift,
.cake,
.big-heart {
  font-size: 75px;
}

.photo-frame {
  max-width: 300px;
  margin: auto;
  padding: 10px;
}

.photo-placeholder {
  height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70px;
}

.heart {
  position: fixed;
  bottom: -50px;
  z-index: 10;
  animation: rise linear forwards;
}

@keyframes rise {
  to {
    transform: translateY(-110vh);
    opacity: 0;
  }
}

.star {
  position: fixed;
  width: 3px;
  height: 3px;
  background: white;
  border-radius: 50%;
}

@media (max-width: 500px) {
  h1 {
    font-size: 35px;
  }

  h2 {
    font-size: 24px;
  }

  p {
    font-size: 16px;
  }

  button {
    width: 100%;
  }
}
